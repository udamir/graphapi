{
  "name": "gqlapi",
  "version": "0.5.1",
  "description": "The GraphAPI Specification Repository",
  "keywords": [
    "api",
    "graphql",
    "introspection",
    "jsonschema",
    "schema"
  ],
  "homepage": "https://udamir.github.io/graphapi/",
  "license": "MIT",
  "author": "Damir Yusipov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/udamir/graphapi.git"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "unpkg": "./dist/gqlapi.iife.js",
  "jsdelivr": "./dist/gqlapi.iife.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:coverage": "vp test run --coverage",
    "check": "vp check",
    "typecheck": "tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "pnpm run check && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "ajv": "^8.20.0",
    "cm6-graphql": "^1.0.0",
    "codemirror": "^6.0.2",
    "graphql": "^17.1.0",
    "js-yaml": "^5.5.0",
    "typescript": "^7.0.2",
    "vite-plus": "^1.7.0",
    "vitepress": "2.0.0-alpha.21",
    "vue": "^3.5.45"
  },
  "peerDependencies": {
    "graphql": "^16.0.0 || ^17.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
